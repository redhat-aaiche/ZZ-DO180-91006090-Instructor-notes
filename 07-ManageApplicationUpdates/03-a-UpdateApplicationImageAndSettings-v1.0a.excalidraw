      "updated": 1769431667986,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "$ git clone https://github.com/redhat-aaiche/ocp-apps.git\n$ cd ocp-apps/php-detail\n\n\n$ oc login -u developer -p developer https://api.ocp4.example.com:6443\n$ oc new-project my-php-application\n\n$ oc new-app --name detail \\\n    https://github.com/redhat-aaiche/ocp-apps.git --context-dir php-detail \\\n    -i php:7.4-ubi8\n$ oc expose svc/detail --hostname detail.apps.ocp4.example.com\n\n$ oc create cm mycm --from-literal=MY_STRING=foo\n$ oc create cm mycmfile --from-file=id_rsa.pub\n$ oc create secret generic mysecret --from-literal=MY_PASSWORD=bar\n$ oc create secret generic mysecfile --from-file=id_rsa\n$ oc set env deploy/detail --from cm/mycm\n$ oc set env deploy/detail --from secret/mysecret\n$ oc set volume deploy/detail \\\n    --add \\\n    --name mycmfile-vol \\\n    -t configmap \\\n    --configmap-name mycmfile \\\n    -m /my_mount\n$ oc set volume deploy/detail \\\n    --add \\\n    --name mysecfile-vol \\\n    -t secret \\\n    --secret-name mysecfile \\\n    -m /my_secret\n\n$ oc set data cm/mycm --from-literal=MY_STRING=baz\n$ oc set data cm/mycmfile --from-file=id_rsa.pub=/etc/fstab\n$ oc set data secret/mysecret --from-literal=MY_PASSWORD=bongle\n$ oc set data secret/mysecfile --from-file=id_rsa=/etc/redhat-release\n\n$ firefox detail.apps.ocp4.example.com &",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "$ git clone https://github.com/redhat-aaiche/ocp-apps.git\n$ cd ocp-apps/php-detail\n\n\n$ oc login -u developer -p developer https://api.ocp4.example.com:6443\n$ oc new-project my-php-application\n\n$ oc new-app --name detail \\\n    https://github.com/redhat-aaiche/ocp-apps.git --context-dir php-detail \\\n    -i php:7.4-ubi8\n$ oc expose svc/detail --hostname detail.apps.ocp4.example.com\n\n$ oc create cm mycm --from-literal=MY_STRING=foo\n$ oc create cm mycmfile --from-file=id_rsa.pub\n$ oc create secret generic mysecret --from-literal=MY_PASSWORD=bar\n$ oc create secret generic mysecfile --from-file=id_rsa\n$ oc set env deploy/detail --from cm/mycm\n$ oc set env deploy/detail --from secret/mysecret\n$ oc set volume deploy/detail \\\n    --add \\\n    --name mycmfile-vol \\\n    -t configmap \\\n    --configmap-name mycmfile \\\n    -m /my_mount\n$ oc set volume deploy/detail \\\n    --add \\\n    --name mysecfile-vol \\\n    -t secret \\\n    --secret-name mysecfile \\\n    -m /my_secret\n\n$ oc set data cm/mycm --from-literal=MY_STRING=baz\n$ oc set data cm/mycmfile --from-file=id_rsa.pub=/etc/fstab\n$ oc set data secret/mysecret --from-literal=MY_PASSWORD=bongle\n$ oc set data secret/mysecfile --from-file=id_rsa=/etc/redhat-release\n\n$ firefox detail.apps.ocp4.example.com &",
      "lineHeight": 1.2,
      "baseline": 1237,
      "index": "b0h",
      "autoResize": true
    },
