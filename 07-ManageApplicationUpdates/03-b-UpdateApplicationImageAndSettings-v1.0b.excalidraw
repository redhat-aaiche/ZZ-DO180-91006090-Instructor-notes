      "boundElements": [],
      "updated": 1790266987813,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "- and now we have an application deployment :\n    ° so the image stream points to the image, \n    ° then we have the deployment that uses \n      the image stream \n    ° and the purpose of the deployment is \n      that it creates pods that specifies all\n      of the properties with which your pods\n      are going to be instantiated\n- and then we have the service that points\n  to your pods",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- and now we have an application deployment :\n    ° so the image stream points to the image, \n    ° then we have the deployment that uses \n      the image stream \n    ° and the purpose of the deployment is \n      that it creates pods that specifies all\n      of the properties with which your pods\n      are going to be instantiated\n- and then we have the service that points\n  to your pods",
      "lineHeight": 1.2,
      "baseline": 330,
      "index": "cAJJ",
      "autoResize": true,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 418,
      "versionNonce": 1056138128,
      "isDeleted": true,
      "id": "CV_KsUXxy8RukH47v9IoQ",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 140,
      "y": 103807.3610479279,
      "strokeColor": "#495057",
