    {
      "type": "text",
      "version": 195,
      "versionNonce": 601346098,
      "index": "c09S",
      "isDeleted": false,
      "id": "5ErJn2VswUENe1M5wUxyn",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -180.00000000000045,
      "y": 611.4917936635347,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "width": 1033.199951171875,
      "height": 436.8,
      "seed": 389744754,
      "groupIds": [
        "MRizcVRL_S-72y3vjrNuk",
        "yvL7AFgKtEjv_yMSzy0Nz",
        "tYZe96jM6sszWZ71wvJ3l"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790189368753,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "- Think about DNS entry, right?\n- Do you know the IP address for redhat.com?\n- I work at Red Hat :\n    ° I don't even know the IP address for redhat.com,\n\n==> So, instead we have these DNS entries that are :\n        ° like pointers to the IP address or the IP addresses\n          that represent the web server for redhat.com.\n\n==> Similarly, think of an image stream as being like DNS entry\n==> It's a simple name that references an image located at\n    an image registry \n    and these image stream have got lots and lots of metadata",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Think about DNS entry, right?\n- Do you know the IP address for redhat.com?\n- I work at Red Hat :\n    ° I don't even know the IP address for redhat.com,\n\n==> So, instead we have these DNS entries that are :\n        ° like pointers to the IP address or the IP addresses\n          that represent the web server for redhat.com.\n\n==> Similarly, think of an image stream as being like DNS entry\n==> It's a simple name that references an image located at\n    an image registry \n    and these image stream have got lots and lots of metadata",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1790189368739,
      "labelPosition": null,
      "baseFontSize": null
    },
