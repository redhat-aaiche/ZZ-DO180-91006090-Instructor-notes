    {
      "type": "text",
      "version": 506,
      "versionNonce": 1911680430,
      "index": "bxZ",
      "isDeleted": false,
      "id": "AgVY3n8RMHTMoUVgL9cAc",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
