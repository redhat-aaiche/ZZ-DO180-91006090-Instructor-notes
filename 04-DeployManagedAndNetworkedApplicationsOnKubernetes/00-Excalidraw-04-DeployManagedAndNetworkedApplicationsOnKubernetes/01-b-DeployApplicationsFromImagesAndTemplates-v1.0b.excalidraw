      "opacity": 100,
      "angle": 0,
      "x": -286.2711549271546,
      "y": -14982.709974339316,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "width": 1100.63330078125,
      "height": 360,
      "seed": 1288513202,
      "groupIds": [
        "_gqXTEpnDJhtRjPomFIFm"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790189368753,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Now the basic premise of template is that the template :\n        ° will create what you tell it to create.\n\n    ==> So if you tell your template to create :\n            ° a build config, \n            ° imagestream, \n            ° deployment, \n         it will do just that.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Now the basic premise of template is that the template :\n        ° will create what you tell it to create.\n\n    ==> So if you tell your template to create :\n            ° a build config, \n            ° imagestream, \n            ° deployment, \n         it will do just that.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790189368726,
      "labelPosition": null,
      "baseFontSize": null
    },
