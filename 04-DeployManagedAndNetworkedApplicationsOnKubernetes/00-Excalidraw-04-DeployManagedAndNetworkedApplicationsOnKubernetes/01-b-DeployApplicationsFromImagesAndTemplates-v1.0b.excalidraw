      "boundElements": [],
      "updated": 1790189368754,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "- But deployments and deploymentconfigs\n  have got different features",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- But deployments and deploymentconfigs\n  have got different features",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1790189368745,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 958,
      "versionNonce": 927401138,
      "index": "c0Ji",
      "isDeleted": false,
      "id": "UH6Hq0FHB8AQqNcWCqG3C",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 59.376926128680566,
      "y": 28096.403881575632,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 623.2000122070312,
      "height": 235.20000000000002,
      "seed": 1032499570,
      "groupIds": [
        "FPOw-OajTLPvA36RbY5W4"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790189368754,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "DeploymentConfigs:\n° predate Deployments\n° are templates for how to deploy pods\n° have always been part of OpenShift\n    - are OpenShift specific resources\n° other K8s distribution will not this\n  resource",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DeploymentConfigs:\n° predate Deployments\n° are templates for how to deploy pods\n° have always been part of OpenShift\n    - are OpenShift specific resources\n° other K8s distribution will not this\n  resource",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1790189368745,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 1031,
      "versionNonce": 136206190,
      "index": "c0Jj",
      "isDeleted": false,
      "id": "FJiM2jUyyWb_fbqC5a8OP",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 110.77692002516494,
      "y": 27847.43245300419,
