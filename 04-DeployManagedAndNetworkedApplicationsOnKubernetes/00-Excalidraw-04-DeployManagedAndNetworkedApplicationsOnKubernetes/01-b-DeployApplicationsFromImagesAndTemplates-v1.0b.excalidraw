      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790189368754,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "Deployments:\n° are native Kubernetes resources\n° were created after DeploymentConfigs\n° by default, we make use of Deployments\n    - this is recommended",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deployments:\n° are native Kubernetes resources\n° were created after DeploymentConfigs\n° by default, we make use of Deployments\n    - this is recommended",
      "autoResize": true,
      "lineHeight": 1.2,
