      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "- And one of the main differences between :\n    ° a Kubernetes ingress \n  and\n    ° an OpenShift route \n\n  ==> is the level of abstraction",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- And one of the main differences between :\n    ° a Kubernetes ingress \n  and\n    ° an OpenShift route \n\n  ==> is the level of abstraction",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790190283076,
      "labelPosition": null,
      "baseFontSize": null
    },
