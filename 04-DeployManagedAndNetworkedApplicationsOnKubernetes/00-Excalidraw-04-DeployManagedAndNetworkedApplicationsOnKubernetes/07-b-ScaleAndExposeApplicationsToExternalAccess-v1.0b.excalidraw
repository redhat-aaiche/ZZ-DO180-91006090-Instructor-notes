      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "# ---------------------------------------------------------------------\n# round robin balancing for OCP4 Ingress Secure Port\n# ---------------------------------------------------------------------\nfrontend ingress_secure_ocp4\n  bind 192.168.50.254:443\n  mode tcp\n  default_backend ingress_secure_backend_ocp4\nbackend ingress_secure_backend_ocp4\n  balance roundrobin\n  mode tcp\n  # example:\n  # server master01 192.168.50.10:443 check\n  server master01 192.168.50.10:443 check\n      ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# ---------------------------------------------------------------------\n# round robin balancing for OCP4 Ingress Secure Port\n# ---------------------------------------------------------------------\nfrontend ingress_secure_ocp4\n  bind 192.168.50.254:443\n  mode tcp\n  default_backend ingress_secure_backend_ocp4\nbackend ingress_secure_backend_ocp4\n  balance roundrobin\n  mode tcp\n  # example:\n  # server master01 192.168.50.10:443 check\n  server master01 192.168.50.10:443 check\n      ",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1790190283089,
      "labelPosition": null,
      "baseFontSize": null
    },
