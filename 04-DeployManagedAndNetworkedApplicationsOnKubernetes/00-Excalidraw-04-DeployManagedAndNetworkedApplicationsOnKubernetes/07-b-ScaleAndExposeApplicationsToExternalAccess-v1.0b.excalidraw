      "fontSize": 37.29732845673817,
      "fontFamily": 1,
      "text": "Putting the Puzzle Together :",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Putting the Puzzle Together :",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790190283076,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 3218,
      "versionNonce": 504725678,
      "index": "buq",
      "isDeleted": false,
      "id": "wczlJBrUtcAywk6DZXWpN",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -1245.0642981756332,
      "y": -20465.483223433715,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "width": 1036.11669921875,
      "height": 225,
      "seed": 1162738414,
      "groupIds": [
        "bOWszxnMnXIh1owgmf6v1"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790190283093,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Here we have a bunch of Pods :\n\n        ° These Pods are instantiated by the Deployment\n        ° In front of these Pods :\n            - we have a Service",
      "textAlign": "left",
