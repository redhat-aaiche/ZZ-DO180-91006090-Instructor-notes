    {
      "type": "text",
      "version": 84,
      "versionNonce": 1760346034,
      "index": "c0B3",
      "isDeleted": false,
      "id": "9Z0KyUnABbBVTJxcD9bzt",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -1104.7481347733674,
      "y": 28721.875,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 1164.4000244140625,
      "height": 436.8,
      "seed": 1719472174,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [
        {
          "id": "vkT3af_igE2rC5_UDAVTg",
          "type": "arrow"
        },
        {
          "id": "E2a_UgEmzdC58NRfGtDvS",
          "type": "arrow"
        }
      ],
      "updated": 1790190283094,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "# ---------------------------------------------------------------------\n# round robin balancing for OCP4 Ingress Insecure Port\n# ---------------------------------------------------------------------\nfrontend ingress_insecure_ocp4\n  bind 192.168.50.254:80\n  mode tcp\n  default_backend ingress_insecure_backend_ocp4\nbackend ingress_insecure_backend_ocp4\n  balance roundrobin\n  mode tcp\n  # example:\n  # server master01 192.168.50.10:80 check\n  server master01 192.168.50.10:80 check",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# ---------------------------------------------------------------------\n# round robin balancing for OCP4 Ingress Insecure Port\n# ---------------------------------------------------------------------\nfrontend ingress_insecure_ocp4\n  bind 192.168.50.254:80\n  mode tcp\n  default_backend ingress_insecure_backend_ocp4\nbackend ingress_insecure_backend_ocp4\n  balance roundrobin\n  mode tcp\n  # example:\n  # server master01 192.168.50.10:80 check\n  server master01 192.168.50.10:80 check",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1790190283089,
      "labelPosition": null,
      "baseFontSize": null
    },
