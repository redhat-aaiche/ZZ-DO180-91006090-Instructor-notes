      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -289.5234679803573,
      "y": -37613.80952380959,
      "strokeColor": "#495057",
      "backgroundColor": "#ffffff",
      "width": 854.8333129882812,
      "height": 450,
      "seed": 2017373810,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790185131824,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> what we can now do is that \n    ==> we can CREATE OTHER PARTITIONS \n        over here. \n        Other partitions of :\n            ° processors, \n            ° memory pages, \n            ° users, \n            ° files, \n        and \n            ° so forth.",
      "textAlign": "left",
