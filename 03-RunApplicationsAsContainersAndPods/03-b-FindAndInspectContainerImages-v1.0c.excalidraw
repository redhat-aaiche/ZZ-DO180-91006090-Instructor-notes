      "opacity": 100,
      "angle": 0,
      "x": -712.3855884721875,
      "y": -15359.310600565012,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 927.816650390625,
      "height": 225,
      "seed": 2132807214,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790185477476,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> We also have other public image registries \n--> you may host your own Private Image Registries\n    on PREMISE \n    or\n    you could have it in the cloud",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> We also have other public image registries \n--> you may host your own Private Image Registries\n    on PREMISE \n    or\n    you could have it in the cloud",
      "autoResize": true,
      "lineHeight": 1.25,
