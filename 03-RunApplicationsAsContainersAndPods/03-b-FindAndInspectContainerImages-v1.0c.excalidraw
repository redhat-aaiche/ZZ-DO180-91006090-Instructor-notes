      "boundElements": [],
      "updated": 1790185477476,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Now, there may be other registries on the internet\n\n--> There's another one that is affiliated with Red Hat\n    is called : \n        ° quay.io\n--> quay.io is a Public Image Registry :\n        ° Anyone, myself included, can upload images at quay.io\n        ° And as such, you could host Images, \n          you could host your own Images there",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Now, there may be other registries on the internet\n\n--> There's another one that is affiliated with Red Hat\n    is called : \n        ° quay.io\n--> quay.io is a Public Image Registry :\n        ° Anyone, myself included, can upload images at quay.io\n        ° And as such, you could host Images, \n          you could host your own Images there",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790185477416,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 171,
      "versionNonce": 909450414,
