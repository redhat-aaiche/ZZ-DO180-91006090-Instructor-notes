      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> rsync :\n    ° is a tool that allows me to transfer \n      the differences\n        ==>  its not going to transfer 100% of the data \n             each and every single time ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> rsync :\n    ° is a tool that allows me to transfer \n      the differences\n        ==>  its not going to transfer 100% of the data \n             each and every single time ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790185685103,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 1224,
      "versionNonce": 1102550318,
      "index": "bxA",
      "isDeleted": false,
      "id": "IuSxTmaZ4XnG4uSwMuB22",
