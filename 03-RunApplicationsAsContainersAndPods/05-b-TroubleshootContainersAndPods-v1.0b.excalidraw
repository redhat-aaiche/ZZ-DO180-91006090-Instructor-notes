      "y": 6143.658333333332,
      "strokeColor": "#0c8599",
      "backgroundColor": "#fab005",
      "width": 885.5999755859375,
      "height": 168,
      "seed": 122508526,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790185685108,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "$ mkdir -v web2_app_logs\n$\n$ oc rsync web2-xxx-xxx:/var/log/httpd/ web2_app_logs/\n$\n$ ls -l web2_app_logs/",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "$ mkdir -v web2_app_logs\n$\n$ oc rsync web2-xxx-xxx:/var/log/httpd/ web2_app_logs/\n$\n$ ls -l web2_app_logs/",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1790185685103,
      "labelPosition": null,
      "baseFontSize": null
    },
