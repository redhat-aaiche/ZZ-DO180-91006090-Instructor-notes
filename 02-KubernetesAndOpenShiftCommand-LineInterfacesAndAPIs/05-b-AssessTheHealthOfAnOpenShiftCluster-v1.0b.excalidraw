    },
    {
      "type": "text",
      "version": 330,
      "versionNonce": 1309377646,
      "index": "c0KX",
      "isDeleted": false,
      "id": "OYnOAv1RPdZJkO1GwsxGz",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 138.89166259765614,
      "y": 31153.041666666664,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1090.550048828125,
      "height": 360,
      "seed": 933688946,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790183377212,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Alerting is facilitated by Alert Manager :\n        ° we have these rules \n    and \n        ° if a rule evaluates to true for longer than \n          the evaluation threshold, \n            ==> then the rule is considered firing\n                    ==> And when a rule is considered firing, \n                        it sends out notifications.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Alerting is facilitated by Alert Manager :\n        ° we have these rules \n    and \n        ° if a rule evaluates to true for longer than \n          the evaluation threshold, \n            ==> then the rule is considered firing\n                    ==> And when a rule is considered firing, \n                        it sends out notifications.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790183377202,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
