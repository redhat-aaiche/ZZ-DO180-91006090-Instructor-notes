      "y": 31607.041666666664,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1142.75,
      "height": 135,
      "seed": 740513842,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [
        {
          "id": "Xz34J-hQ-BQseX3B3mMBb",
          "type": "arrow"
        }
      ],
      "updated": 1790183377212,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Notifications - to say something has gone wrong - could be :\n        ° Messages in Slack,\n        ° Emails",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Notifications - to say something has gone wrong - could be :\n        ° Messages in Slack,\n        ° Emails",
