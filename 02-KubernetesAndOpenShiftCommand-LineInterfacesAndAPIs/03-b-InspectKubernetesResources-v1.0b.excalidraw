      "fontFamily": 3,
      "text": "- \" . \" : dot means : \n    ° start at the root",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- \" . \" : dot means : \n    ° start at the root",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1790182213451,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 503,
      "versionNonce": 1413737134,
      "index": "c094",
      "isDeleted": false,
      "id": "2kjP_Q_QUpzU5F-9oZz1U",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 823.5336812843151,
      "y": 20746.958774464794,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "width": 1180.800048828125,
      "height": 302.40000000000003,
