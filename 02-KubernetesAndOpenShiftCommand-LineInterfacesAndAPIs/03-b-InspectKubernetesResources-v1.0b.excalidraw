      "text": "$ oc get deployments -o jsonpath=\\\n      '{range .items[*]} \\\n         {\"\\n--> The depolyment called \"} \\\n            {.metadata.name} \\\n            {\" uses an image called:\\n  - \"} \\\n            {.spec.template.spec.containers[].image} \\\n            {\"\\n\\n\"} \\\n      {end}'",
