      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790182215099,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "- we need to drill \n    ° down dot (.) \n    ° template dot (.)\n    ° spec dot(.), \n  ==> because we're going down one dictionary down\n    ° containers square brackets ([])\n  ==> because we want to return the data for all indices\n    ° image\n  ==> And then we have the key that we are interested in is called image",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- we need to drill \n    ° down dot (.) \n    ° template dot (.)\n    ° spec dot(.), \n  ==> because we're going down one dictionary down\n    ° containers square brackets ([])\n  ==> because we want to return the data for all indices\n    ° image\n  ==> And then we have the key that we are interested in is called image",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1790182213451,
      "labelPosition": null,
      "baseFontSize": null
    },
