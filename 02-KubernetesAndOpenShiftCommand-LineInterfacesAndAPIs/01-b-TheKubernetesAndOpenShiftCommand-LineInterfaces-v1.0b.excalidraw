      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Both :\n        ° oc\n    and \n        ° kubectl\n    available at \n        /usr/local/bin/",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Both :\n        ° oc\n    and \n        ° kubectl\n    available at \n        /usr/local/bin/",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790181949674,
      "labelPosition": null,
      "baseFontSize": null
    },
