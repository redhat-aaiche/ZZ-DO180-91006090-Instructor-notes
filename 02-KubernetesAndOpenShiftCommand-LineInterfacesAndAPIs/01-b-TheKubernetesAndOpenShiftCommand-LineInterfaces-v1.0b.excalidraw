      "updated": 1790181949713,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> We also discovered early on is that \n        ° they are :\n            * the same binary\n            * the same file",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> We also discovered early on is that \n        ° they are :\n            * the same binary\n            * the same file",
