      "roundness": null,
      "boundElements": [],
      "updated": 1790179236505,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> It includes 30 days free access to a shared :\n    OpenShift and Kubernetes cluster",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> It includes 30 days free access to a shared :\n    OpenShift and Kubernetes cluster",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790179236502,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
