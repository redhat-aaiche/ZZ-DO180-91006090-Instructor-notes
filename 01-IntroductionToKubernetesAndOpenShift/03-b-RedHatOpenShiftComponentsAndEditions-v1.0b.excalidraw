      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> It is another way to get started quickly ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> It is another way to get started quickly ",
      "autoResize": true,
      "lineHeight": 1.25,
