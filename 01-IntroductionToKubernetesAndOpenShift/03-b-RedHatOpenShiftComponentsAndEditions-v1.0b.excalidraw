      "roundness": null,
      "boundElements": [],
      "updated": 1790179236505,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> There are so many more services :\n    ° We have an Image Registry that is INTERNAL\n    ° We have a Monitoring Stack, \n    ° There's an Alerting Framework,\n    ° There's a Web Console,\n    ° There's a service catalogue \n\n\n\n\n    ° There's a rich logging framework,\n    ° There's a great networking stack",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> There are so many more services :\n    ° We have an Image Registry that is INTERNAL\n    ° We have a Monitoring Stack, \n    ° There's an Alerting Framework,\n    ° There's a Web Console,\n    ° There's a service catalogue \n\n\n\n\n    ° There's a rich logging framework,\n    ° There's a great networking stack",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790179236498,
      "labelPosition": null,
      "baseFontSize": null
    },
