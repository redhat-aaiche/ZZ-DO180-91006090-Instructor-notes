      "y": 4946.8749999999845,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "width": 1111.6666259765625,
      "height": 360,
      "seed": 791528690,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790179236505,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Guided tutorials to experience and run sample Applications\n\n--> Modify and build on top of pre-built sample Applications\n\n--> Access the browser-based Red Hat OpenShift Dev Spaces\n    ( formerly CodeReady Workspaces )\n\n--> GitHub integration to your own source code",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Guided tutorials to experience and run sample Applications\n\n--> Modify and build on top of pre-built sample Applications\n\n--> Access the browser-based Red Hat OpenShift Dev Spaces\n    ( formerly CodeReady Workspaces )\n\n--> GitHub integration to your own source code",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790179236502,
      "labelPosition": null,
      "baseFontSize": null
    }
