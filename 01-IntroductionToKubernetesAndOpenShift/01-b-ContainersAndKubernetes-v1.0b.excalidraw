      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> This is where :\n        - you would find container images \n              ° that we build, \n              ° that we make available \n                to our customers",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> This is where :\n        - you would find container images \n              ° that we build, \n              ° that we make available \n                to our customers",
