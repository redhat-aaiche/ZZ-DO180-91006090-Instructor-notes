      "roundness": null,
      "boundElements": [],
      "updated": 1790179006113,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> That again, is an example of a container Image registry\n        - you may notice on the whiteboard that I have an asterisk (*) \n              ==> it does require authentication",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> That again, is an example of a container Image registry\n        - you may notice on the whiteboard that I have an asterisk (*) \n              ==> it does require authentication",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790179006039,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 503,
      "versionNonce": 1163780462,
      "index": "c07x",
      "isDeleted": false,
      "id": "pUtFkTRnOmZ6FVE81LBNZ",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 459.5083414713532,
      "y": -2430.976190476217,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff",
      "width": 710.9833374023438,
      "height": 225,
      "seed": 46421170,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790179006113,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> So, you would just sign in with your \n   redhat.com user name and password \n   and then, \n   from there you can access the \n   container images.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> So, you would just sign in with your \n   redhat.com user name and password \n   and then, \n   from there you can access the \n   container images.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1790179006039,
      "labelPosition": null,
      "baseFontSize": null
    },
