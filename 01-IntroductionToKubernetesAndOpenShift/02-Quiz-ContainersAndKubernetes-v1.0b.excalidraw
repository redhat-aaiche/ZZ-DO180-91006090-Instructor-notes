      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "text": "- You can install the OpenShift Pipelines Operator via the command line using a little bit of YAML:",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- You can install the OpenShift Pipelines Operator via the command line using a little bit of YAML:",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "nlgeurxpz4bSQRZAcw4vM",
      "type": "text",
      "x": 768.1838656396204,
      "y": -5921.106246913091,
      "width": 672.4000244140625,
      "height": 436.8,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bog",
      "roundness": null,
      "seed": 107012712,
      "version": 71,
      "versionNonce": 2012670474,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "text": "cat <<EOF | kubectl apply -f -\napiVersion: operators.coreos.com/v1alpha1\nkind: Subscription\nmetadata:\n  name: openshift-pipelines-operator\n  namespace: openshift-operators\nspec:\n  channel:  stable\n  name: openshift-pipelines-operator-rh\n  source: redhat-operators\n  sourceNamespace: openshift-marketplace\nEOF\n",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cat <<EOF | kubectl apply -f -\napiVersion: operators.coreos.com/v1alpha1\nkind: Subscription\nmetadata:\n  name: openshift-pipelines-operator\n  namespace: openshift-operators\nspec:\n  channel:  stable\n  name: openshift-pipelines-operator-rh\n  source: redhat-operators\n  sourceNamespace: openshift-marketplace\nEOF\n",
