      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> OpenShift Pipelines is a CI/CD system based on the \n    open source Tekton project :",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> OpenShift Pipelines is a CI/CD system based on the \n    open source Tekton project :",
