    {
      "id": "vNtdiRejW0Su94uV75Shq",
      "type": "text",
      "x": 706.517198972954,
      "y": -306.27291357975673,
      "width": 1082.4000244140625,
      "height": 168,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bp7",
      "roundness": null,
      "seed": 230862360,
      "version": 14,
      "versionNonce": 279407370,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "text": "- A Step is a series of commands that achieve a specific goal, \n such as building an image. Each Step runs sequentially in its\n  own container inside a Task’s pod. Since the containers in a pod\n  can optionally share resources, Steps in a Task can use common\n  shared volumes, ConfigMaps, and Secrets",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- A Step is a series of commands that achieve a specific goal, \n such as building an image. Each Step runs sequentially in its\n  own container inside a Task’s pod. Since the containers in a pod\n  can optionally share resources, Steps in a Task can use common\n  shared volumes, ConfigMaps, and Secrets",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
