      "boundElements": [],
      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "- With Pipelines, you can trigger repeatable builds \n when source code changes, integrate tests into the\n  process, and configure automatic redeployment \n strategies, from rolling updates to \n traffic-splitting A/B testing on a single cluster",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- With Pipelines, you can trigger repeatable builds \n when source code changes, integrate tests into the\n  process, and configure automatic redeployment \n strategies, from rolling updates to \n traffic-splitting A/B testing on a single cluster",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 1178,
      "versionNonce": 1425638550,
      "index": "blG",
      "isDeleted": true,
      "id": "_MHQLGveCQGtpOuwBTNXV",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 540.2505363752967,
      "y": -10169.237199294048,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1395.63330078125,
      "height": 270,
      "seed": 1513243669,
      "groupIds": [
        "CazmGZXllFeGIbRwVKFvH"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> The OpenShift Pipelines Operator installs and manages \n   Pipelines components and services. \n   This includes automatically updating Pipelines as new versions are released\n\n-->  You’ll add the Pipelines Operator to your OpenShift cluster. \n    Then you’ll be ready to create a pipeline",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> The OpenShift Pipelines Operator installs and manages \n   Pipelines components and services. \n   This includes automatically updating Pipelines as new versions are released\n\n-->  You’ll add the Pipelines Operator to your OpenShift cluster. \n    Then you’ll be ready to create a pipeline",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
