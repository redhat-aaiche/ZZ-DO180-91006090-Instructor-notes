    {
      "id": "kSs-Z2ihHG4-PyOCTWb2P",
      "type": "text",
      "x": 579.8505323062877,
      "y": -9550.689580246424,
      "width": 1377.5999755859375,
      "height": 235.20000000000002,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "boU",
      "roundness": null,
      "seed": 67218456,
      "version": 23,
      "versionNonce": 428939658,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "text": "- The OperatorHub is a catalog of available Operators in the OpenShift\n  Web Console Administrator view. Administrators establish a subscription\n  to an Operator in the OperatorHub, after which the application or\n service that the Operator manages is available for instantiation in\n one or more cluster namespaces. You’ll use the OperatorHub to find \nand install the Red Hat OpenShift Pipelines Operator. \nThen you’ll switch back to your developer role and create and run an actual pipeline",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- The OperatorHub is a catalog of available Operators in the OpenShift\n  Web Console Administrator view. Administrators establish a subscription\n  to an Operator in the OperatorHub, after which the application or\n service that the Operator manages is available for instantiation in\n one or more cluster namespaces. You’ll use the OperatorHub to find \nand install the Red Hat OpenShift Pipelines Operator. \nThen you’ll switch back to your developer role and create and run an actual pipeline",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
